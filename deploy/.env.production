# ===== 数据库（云端 ai_interview_agent 账号 / ai_interview_agent 库）=====
# v2.0 起实际配置：宝塔面板 → 数据库 → ai_interview_agent
DB_USER=ai_interview_agent
DB_PASSWORD=PLEASE_FILL_PASSWORD
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ai_interview_agent

# ===== Flask =====
# 用这个命令生成：openssl rand -hex 32
SECRET_KEY=PLEASE_REPLACE_WITH_OPENSSL_RAND_HEX_32

# ===== LLM（MiniMax-M3，v2.0 起切换；旧 DeepSeek 已弃用）=====
# 官方文档：https://platform.minimaxi.com/docs/guides/text-generation
# OpenAI 兼容协议，只需替换 base_url / model / api_key 三个变量
LLM_API_URL=https://api.minimaxi.com/v1/chat/completions
LLM_API_KEY=PLEASE_FILL_YOUR_MINIMAX_KEY
LLM_MODEL=MiniMax-M3
LLM_TIMEOUT=120

# ===== 讯飞实时语音转写（主用）=====
XFYUN_APP_ID=PLEASE_FILL
XFYUN_API_KEY=PLEASE_FILL

# ===== 腾讯云语音识别（备用）=====
TENCENT_APP_ID=PLEASE_FILL
TENCENT_SECRET_ID=PLEASE_FILL
TENCENT_SECRET_KEY=PLEASE_FILL
# ===== 数据库（云端 ai_app 账号，库名 ai_interview_prod）=====
DB_USER=ai_app
