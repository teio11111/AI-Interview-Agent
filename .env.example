# =============================================================================
# AI-Interview-Agent 环境变量模板
# =============================================================================
# 复制此文件为 .env 并填写真实值：
#   cp .env.example .env
# .env 已被 .gitignore 忽略，不会提交到代码仓库
# =============================================================================

# --- Flask 基础配置 ---
# 生产环境必须改为随机长字符串（可用 python -c "import secrets; print(secrets.token_hex(32))" 生成）
SECRET_KEY=dev-secret-key-change-in-production
# 0 = 生产模式（推荐），1 = 调试模式（仅开发）
FLASK_DEBUG=0

# --- MySQL 数据库配置 ---
DB_USER=root
DB_PASSWORD=Root123456
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ai_interview

# --- LLM API 配置（DeepSeek / OpenAI 兼容协议）---
# DeepSeek 示例：
# LLM_API_URL=https://api.deepseek.com/v1/chat/completions
# LLM_MODEL=deepseek-chat
# OpenAI 示例：
# LLM_API_URL=https://api.openai.com/v1/chat/completions
# LLM_MODEL=gpt-3.5-turbo
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-3.5-turbo
LLM_TIMEOUT=90

# --- xiaozhi-unity WebSocket 桥接服务 ---
# 手机连接电脑时的地址示例：ws://192.168.1.100:8089/xiaozhi/v1/
XIAOZHI_WS_HOST=0.0.0.0
XIAOZHI_WS_PORT=8089
XIAOZHI_WS_PATH=/xiaozhi/v1/
# 默认 test-token 仅用于本地联调，生产环境请修改
XIAOZHI_ACCESS_TOKEN=test-token
XIAOZHI_INPUT_SAMPLE_RATE=16000
XIAOZHI_OUTPUT_SAMPLE_RATE=24000
XIAOZHI_FRAME_DURATION_MS=60
# 未设置时自动复用上面的 LLM_* 配置
XIAOZHI_LLM_API_URL=
XIAOZHI_LLM_API_KEY=
XIAOZHI_LLM_MODEL=
XIAOZHI_LLM_TIMEOUT=90
# 1 开启 Edge TTS；需要先安装 requirements_xiaozhi.txt
XIAOZHI_TTS_ENABLED=1
XIAOZHI_TTS_VOICE=zh-CN-XiaoxiaoNeural
XIAOZHI_MAX_HISTORY=12
XIAOZHI_MAX_MESSAGE_SIZE=2097152
# 可选 WSS 证书配置
# XIAOZHI_SSL_CERT=
# XIAOZHI_SSL_KEY=
# 可选面试上下文
XIAOZHI_INTERVIEW_ROLE=技术面试官
XIAOZHI_POSITION_NAME=
XIAOZHI_POSITION_REQUIREMENTS=
XIAOZHI_RESUME_TEXT=

# --- SSE 流式接口超时（秒）---
# 简历评估 SSE 单次最长等待
SSE_TIMEOUT=180
# 完整候选人分析 SSE（含面试+出题）最长等待
SSE_LONG_TIMEOUT=320
