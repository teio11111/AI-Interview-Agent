# =============================================================================
# AI-Interview-Agent 环境变量模板
# =============================================================================
# 复制此文件为 .env 并填写真实值：
#   cp .env.example .env
# .env 已被 .gitignore 忽略，不会提交到代码仓库
# =============================================================================

# --- Flask 基础配置 ---
# 生产环境必须改为随机长字符串（可用 python -c "import secrets; print(secrets.token_hex(32))" 生成）
SECRET_KEY=dev-secret-key-change-in-production
# 0 = 生产模式（推荐），1 = 调试模式（仅开发）
FLASK_DEBUG=0

# --- MySQL 数据库配置 ---
DB_USER=root
DB_PASSWORD=Root123456
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ai_interview

# --- LLM API 配置（DeepSeek / OpenAI 兼容协议）---
# DeepSeek 示例：
# LLM_API_URL=https://api.deepseek.com/v1/chat/completions
# LLM_MODEL=deepseek-chat
# OpenAI 示例：
# LLM_API_URL=https://api.openai.com/v1/chat/completions
# LLM_MODEL=gpt-3.5-turbo
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-3.5-turbo
LLM_TIMEOUT=90

# --- SSE 流式接口超时（秒）---
# 简历评估 SSE 单次最长等待
SSE_TIMEOUT=180
# 完整候选人分析 SSE（含面试+出题）最长等待
SSE_LONG_TIMEOUT=320
